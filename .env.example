# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3001
NODE_ENV=production

# ==========================================
# CREDENCIALES MANYCHAT
# ==========================================
# Token de ManyChat para la API (/fb/sending/sendContent)
MANYCHAT_API_TOKEN=tu_token_manychat_aqui

# ==========================================
# CREDENCIALES INTELIGENCIA ARTIFICIAL
# ==========================================
# API Key de OpenRouter (o OpenAI si usas directamente openai)
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
# URL Base si usas OpenRouter con LangChain (opcional si usas la clase nativa de openai cambiando el baseUrl)
# OPENAI_API_BASE=https://openrouter.ai/api/v1 

# ==========================================
# CREDENCIALES SUPABASE
# ==========================================
SUPABASE_URL=https://tu_proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# ==========================================
# CONFIGURACIÓN LOCALTUNNEL (Solo desarrollo local)
# ==========================================
# Subdominio deseado para localtunnel (ej. mi-bot-ambiente)
LOCALTUNNEL_SUBDOMAIN=ambiente-muni-tucuman
