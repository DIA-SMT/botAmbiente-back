    {
      "parameters": {
        "jsCode": "// Obtener resultados de los nodos anteriores\n// IMPORTANTE: Asegúrate de que los nombres de los nodos coincidan\nlet tickets = [];\nlet programs = [];\n\nconst chatId = $('Webhook1').first().json.body.id;\n\ntry {\n    // Si tu nodo se llama distinto, cambia 'Get Tickets' por el nombre real\n    tickets = $('Get Tickets').all().map(i => i.json);\n} catch (e) { }\n\ntry {\n    // Idem para programas\n    programs = $('Get Program Requests').all().map(i => i.json);\n} catch (e) { }\n\nconst allRecords = [...tickets, ...programs];\n\n// Ordenar por fecha (más reciente primero)\nallRecords.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n\nlet message = \"\";\n\nif (allRecords.length === 0) {\n  message = \"No encontré trámites registrados con tu número en nuestro sistema. 🌱\";\n} else {\n  message = \"📋 *Tus Trámites Registrados:*\\n\\n\";\n\n  allRecords.forEach((record, index) => {\n    const date = new Date(record.created_at).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' });\n    const isTicket = record.ticket_type !== undefined;\n\n    // Icono según estado\n    let statusIcon = \"⚪\";\n    const status = record.status || \"Pendiente\";\n    if (status.toLowerCase().includes(\"pendiente\")) statusIcon = \"🟡\";\n    if (status.toLowerCase().includes(\"proceso\") || status.toLowerCase().includes(\"contactado\")) statusIcon = \"🔵\";\n    if (status.toLowerCase().includes(\"resuelto\") || status.toLowerCase().includes(\"cerrado\")) statusIcon = \"🟢\";\n    if (status.toLowerCase().includes(\"rechazado\")) statusIcon = \"🔴\";\n\n    message += `*${index + 1}.* `;\n    \n    if (isTicket) {\n      message += `*${record.ticket_type}* (${date})\\n`;\n      message += `   📍 ${record.address}\\n`;\n    } else {\n      const programType = record.program_type ? record.program_type.toUpperCase() : \"PROGRAMA\";\n      message += `*Solicitud ${programType}* (${date})\\n`;\n    }\n    \n    message += `   Estado: ${statusIcon} _${status}_\\n\\n`;\n  });\n  \n  message += \"\";\n}\n\nreturn { json: { response_text: message, chat_id: chatId } };"
      },
